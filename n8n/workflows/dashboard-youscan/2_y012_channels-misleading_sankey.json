    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Sankey: Channel -> Sub-topic.\nconst rows = $input.all().map(i => i.json);\nconst data = rows.map(r => ({ from: String(unq(r.channel) ?? 'unknown'), to: String(unq(r.subtopic) ?? 'unknown'), flow: Number(r.cnt || 0) }));\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'sankey',\n  data: { datasets: [{ data, colorFrom: () => '#4e79a7', colorTo: () => '#f28e2b' }] },\n  options: { plugins: { title: { display: true, text: chartTitle } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'sankey' } } }];"
      },
