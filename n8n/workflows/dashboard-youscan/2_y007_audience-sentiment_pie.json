      "id": "e3be5128-5a5a-5469-b6b1-00e7b607d7e8",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Pie chart. Top 4 + 'others'.\nconst rows = $input.all().map(i => i.json);\nconst total = rows.reduce((s, r) => s + Number(r[\"cnt\"] || 0), 0) || 1;\nrows.sort((a, b) => Number(b[\"cnt\"]) - Number(a[\"cnt\"]));\nconst top = rows.slice(0, 4);\nconst othersCnt = rows.slice(4).reduce((s, r) => s + Number(r[\"cnt\"] || 0), 0);\nconst labels = top.map(r => String(unq(r[\"audience\"]) ?? 'unknown'));\nconst data = top.map(r => +((true ? (Number(r[\"cnt\"]) / total) * 100 : Number(r[\"cnt\"]))).toFixed(2));\nif (othersCnt > 0) { labels.push(\"others\"); data.push(+((true ? (othersCnt / total) * 100 : othersCnt)).toFixed(2)); }\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'pie',\n  data: { labels, datasets: [{ data }] },\n  options: { plugins: { title: { display: true, text: chartTitle }, legend: { position: 'right' } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'pie' } } }];"
      },
