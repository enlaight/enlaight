    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d, SUM(daily) OVER (ORDER BY d) AS cumulative\nFROM (\n  SELECT DATE_FORMAT(ur.started_on, '%Y-%m-%d') AS d, COUNT(*) AS daily\n  FROM warehouse.ureport_runs ur\n  WHERE ur.flow_id = 3\n    AND ur.started_on >= '{{ $json.start_date }}'\n    AND ur.started_on <  '{{ $json.end_date }}'\n  GROUP BY d\n) AS daily_counts\nORDER BY d;",
        "options": {}
      },
