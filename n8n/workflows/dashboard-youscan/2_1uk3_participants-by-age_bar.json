    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Vertical bar.\nconst rows = $input.all().map(i => i.json);\nconst labels = rows.map(r => String(unq(r[\"age_category\"]) ?? 'unknown'));\nconst data = rows.map(r => Number(r[\"cnt\"] || 0));\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'bar',\n  data: { labels, datasets: [{ label: \"Participants\", data, backgroundColor: '#4e79a7' }] },\n  options: { plugins: { title: { display: true, text: chartTitle } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'bar' } } }];"
      },
