      "id": "4370e975-c470-589b-90d8-095e302692d6",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Pie chart. Top 10 + 'others'.\nconst rows = $input.all().map(i => i.json);\nconst total = rows.reduce((s, r) => s + Number(r[\"concern_count\"] || 0), 0) || 1;\nrows.sort((a, b) => Number(b[\"concern_count\"]) - Number(a[\"concern_count\"]));\nconst top = rows.slice(0, 10);\nconst othersCnt = rows.slice(10).reduce((s, r) => s + Number(r[\"concern_count\"] || 0), 0);\nconst labels = top.map(r => String(unq(r[\"data_source\"]) ?? 'unknown'));\nconst data = top.map(r => +((true ? (Number(r[\"concern_count\"]) / total) * 100 : Number(r[\"concern_count\"]))).toFixed(2));\nif (othersCnt > 0) { labels.push(\"others\"); data.push(+((true ? (othersCnt / total) * 100 : othersCnt)).toFixed(2)); }\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'pie',\n  data: { labels, datasets: [{ data }] },\n  options: { plugins: { title: { display: true, text: chartTitle }, legend: { position: 'right' } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'pie' } } }];"
      },
