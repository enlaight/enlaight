    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT subtopic, DATE(published_at) AS d, COUNT(*) AS cnt\nFROM (\n  SELECT ym.id, ym.published_at,\n    MAX(CASE WHEN ycl.classification_type = 'sub_topic' THEN ycl.result ELSE NULL END) AS subtopic\n  FROM warehouse.youscan_content yc\n  JOIN warehouse.youscan_mentions ym ON ym.id = yc.youscan_mention_id\n  JOIN warehouse.youscan_topics yt ON yt.youscan_topic_id = ym.youscan_topic_id\n  JOIN warehouse.youscan_translations ytr ON ytr.youscan_mention_id = ym.id\n  JOIN warehouse.youscan_classifications ycl ON ycl.youscan_translation_id = ytr.id\n  WHERE yt.client_id = {{ $json.client_id }}\n    AND ytr.translation IS NOT NULL\n    AND ym.published_at >= '{{ $json.start_date }}'\n    AND ym.published_at <= '{{ $json.end_date }}'\n  GROUP BY ym.id\n) t\nWHERE subtopic IS NOT NULL\n  AND subtopic NOT LIKE '%not related%'\n  AND (subtopic LIKE '%prevention%' OR subtopic LIKE '%general%' OR subtopic LIKE '%diagnosis%' OR subtopic LIKE '%spread%' OR subtopic LIKE '%child abuse%' OR subtopic LIKE '%pregnancy%' OR subtopic LIKE '%side effects%' OR subtopic LIKE '%fear%' OR subtopic LIKE '%risk factor%')\nGROUP BY subtopic, d\nORDER BY d ASC, subtopic ASC;",
        "options": {}
      },
      "id": "7de32b13-6077-53b0-9f07-a4084ca95c58",
