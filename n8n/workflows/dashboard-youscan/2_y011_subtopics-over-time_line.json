      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Multi-series line: top 8 sub-topics over time.\nconst rows = $input.all().map(i => i.json);\nconst totals = {};\nconst series = {};   // subtopic -> {date: cnt}\nconst days = new Set();\nfor (const r of rows) {\n  const sub = String(unq(r.subtopic) ?? 'unknown');\n  const d = String(r.d).slice(0, 10);\n  const cnt = Number(r.cnt || 0);\n  totals[sub] = (totals[sub] || 0) + cnt;\n  series[sub] = series[sub] || {};\n  series[sub][d] = cnt;\n  days.add(d);\n}\nconst labels = Array.from(days).sort();\nconst top = Object.entries(totals).sort((a,b) => b[1]-a[1]).slice(0, 8).map(e => e[0]);\nconst palette = ['#4e79a7','#f28e2b','#e15759','#76b7b2','#59a14f','#edc948','#b07aa1','#ff9da7'];\nconst datasets = top.map((sub, i) => ({\n  label: sub,\n  data: labels.map(d => Number(series[sub][d] || 0)),\n  borderColor: palette[i % palette.length],\n  fill: false,\n}));\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'line',\n  data: { labels, datasets },\n  options: { plugins: { title: { display: true, text: chartTitle } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'line' } } }];"
      },
