    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ycl_st.result AS subtopic, COUNT(*) AS cnt\nFROM warehouse.youscan_content yc\nJOIN warehouse.youscan_mentions ym ON ym.id = yc.youscan_mention_id\nJOIN warehouse.youscan_topics yt ON yt.youscan_topic_id = ym.youscan_topic_id\nJOIN warehouse.youscan_translations ytr ON ytr.youscan_mention_id = ym.id\nJOIN warehouse.youscan_classifications ycl_st ON ycl_st.youscan_translation_id = ytr.id AND ycl_st.classification_type = 'sub_topic'\nJOIN warehouse.youscan_classifications ycl_mi ON ycl_mi.youscan_translation_id = ytr.id AND ycl_mi.classification_type = 'misinformation'\nWHERE yt.client_id = {{ $json.client_id }}\n  AND ytr.translation IS NOT NULL\n  AND ym.published_at >= '{{ $json.start_date }}'\n  AND ym.published_at <= '{{ $json.end_date }}'\n  AND ycl_st.result NOT LIKE '%not related%'\n  AND ycl_mi.result IS NOT NULL\n  AND ycl_mi.result NOT LIKE '%no misleading or harmful content in this post%'\n  AND ycl_mi.result NOT LIKE '%no misinterpreting or harmful content in this post%'\nGROUP BY ycl_st.result\nORDER BY cnt DESC\nLIMIT 10;",
        "options": {}
      },
      "id": "8b21e82a-7af6-50cd-9317-843c735ddd60",
