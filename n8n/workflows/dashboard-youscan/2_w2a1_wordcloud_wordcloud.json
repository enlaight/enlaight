    {
      "parameters": {
        "jsCode": "// Wordcloud: concatenate all nlp_prep snippets into a single text blob.\nconst rows = $input.all().map(i => i.json);\nconst text = rows.map(r => String(r.nlp_text ?? '')).filter(Boolean).join(' ').slice(0, 200000);\nreturn [{ json: { status: \"success\", content: { text, format: 'png', width: 800, height: 500, removeStopwords: true, language: 'en', type: 'wordcloud' } } }];"
      },
