    {
      "parameters": {
        "jsCode": "// Single-series line.\nconst rows = $input.all().map(i => i.json);\nconst labels = rows.map(r => String(r[\"d\"] ?? ''));\nconst data = rows.map(r => Number(r[\"cnt\"] || 0));\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'line',\n  data: { labels, datasets: [{ label: \"Number of mentions\", data, fill: false, borderColor: '#4e79a7' }] },\n  options: { plugins: { title: { display: true, text: chartTitle } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'line' } } }];"
      },
