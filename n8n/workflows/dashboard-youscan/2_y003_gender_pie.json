    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  CASE\n    WHEN JSON_UNQUOTE(JSON_EXTRACT(ym.author, '$.gender')) = 'female' THEN 'female'\n    WHEN JSON_UNQUOTE(JSON_EXTRACT(ym.author, '$.gender')) = 'male' THEN 'male'\n    ELSE 'other'\n  END AS gender,\n  COUNT(*) AS cnt\nFROM warehouse.youscan_content yc\nJOIN warehouse.youscan_mentions ym ON ym.id = yc.youscan_mention_id\nJOIN warehouse.youscan_topics yt ON yt.youscan_topic_id = ym.youscan_topic_id\nJOIN warehouse.youscan_translations ytr ON ytr.youscan_mention_id = ym.id\nJOIN warehouse.youscan_classifications ycl ON ycl.youscan_translation_id = ytr.id\nWHERE yt.client_id = {{ $json.client_id }}\n  AND ycl.classification_type = 'sub_topic'\n  AND ytr.translation IS NOT NULL\n  AND JSON_UNQUOTE(JSON_EXTRACT(ym.author, '$.gender')) IN ('female','male')\n  AND ym.youscan_added_at >= '{{ $json.start_date }}'\n  AND ym.youscan_added_at <= '{{ $json.end_date }}'\nGROUP BY gender;",
        "options": {}
      },
      "id": "1d2f0785-3a63-590d-91e1-8ad63c9a0e99",
