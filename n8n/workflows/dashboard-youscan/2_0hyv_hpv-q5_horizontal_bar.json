    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Horizontal bar. Top 10.\nconst rows = $input.all().map(i => i.json);\nrows.sort((a,b) => Number(b[\"cnt\"]) - Number(a[\"cnt\"]));\nconst top = rows.slice(0, 10);\nconst labels = top.map(r => String(unq(r[\"category\"]) ?? 'unknown'));\nconst data = top.map(r => Number(r[\"cnt\"] || 0));\nconst chartTitle = $('Set Params').first().json.chart_title;\nconst chartConfig = {\n  type: 'bar',\n  data: { labels, datasets: [{ label: \"Q-hpv-q5\", data, backgroundColor: '#4e79a7' }] },\n  options: { indexAxis: 'y', plugins: { title: { display: true, text: chartTitle } } }\n};\nreturn [{ json: { status: \"success\", content: { ...chartConfig, type: 'bar' } } }];"
      },
