    },
    {
      "parameters": {
        "jsCode": "function unq(v) {\n  if (typeof v !== 'string') return v;\n  try { const p = JSON.parse(v); return typeof p === 'string' ? p : v; } catch { return v.replace(/^\"|\"$/g, ''); }\n}\n// Table: pass-through with column metadata. Unwrap JSON-quoted label cells.\nconst labelKeys = [\"subtopic\", \"misinformation\"];\nconst rows = $input.all().map(i => {\n  const o = { ...i.json };\n  for (const k of labelKeys) if (k in o) o[k] = unq(o[k]);\n  return o;\n});\nreturn [{ json: { status: \"success\", content: { columns: [{\"key\": \"subtopic\", \"title\": \"Subtopic\"}, {\"key\": \"misinformation\", \"title\": \"Misinformation\"}, {\"key\": \"url\", \"title\": \"URL\"}, {\"key\": \"engagement\", \"title\": \"Engagement\"}, {\"key\": \"text_snippet\", \"title\": \"Text Snippet\"}, {\"key\": \"source\", \"title\": \"Source\"}, {\"key\": \"published_at\", \"title\": \"Published At\"}], dataSource: rows, type: \"table\" } } }];"
      },
