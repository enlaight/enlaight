    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  MAX(CASE WHEN ycl.classification_type = 'sub_topic' THEN ycl.result ELSE NULL END) AS subtopic,\n  MAX(CASE WHEN ycl.classification_type = 'misinformation' THEN ycl.result ELSE NULL END) AS misinformation,\n  MAX(ym.url) AS url,\n  CAST(JSON_EXTRACT(MAX(ym.engagement), '$.engagement') AS UNSIGNED) AS engagement,\n  MAX(LEFT(ytr.translation, 280)) AS text_snippet,\n  MAX(ym.source) AS source,\n  MAX(ym.published_at) AS published_at\nFROM warehouse.youscan_content yc\nJOIN warehouse.youscan_mentions ym ON ym.id = yc.youscan_mention_id\nJOIN warehouse.youscan_topics yt ON yt.youscan_topic_id = ym.youscan_topic_id\nJOIN warehouse.youscan_translations ytr ON ytr.youscan_mention_id = ym.id\nJOIN warehouse.youscan_classifications ycl ON ycl.youscan_translation_id = ytr.id\nWHERE yt.client_id = {{ $json.client_id }}\n  AND ycl.classification_type IN ('sub_topic','misinformation')\n  AND ytr.translation IS NOT NULL\n  AND ym.published_at >= '{{ $json.start_date }}'\n  AND ym.published_at <= '{{ $json.end_date }}'\n  AND ycl.result NOT LIKE '%not related%'\nGROUP BY ym.youscan_mention_id\nORDER BY engagement DESC\nLIMIT 200;",
        "options": {}
      },
      "id": "a9de2243-1d33-5fac-9873-758cd3d312cd",
