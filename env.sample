# -----------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------
APP_DOMAIN=your-app-domain.com
TRAEFIK_ACME_EMAIL=placeholder@email.ai

# -----------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
BACKEND_DB=enlaight_database
BACKEND_DB_USER=enlaight
BACKEND_DB_PASSWORD=enlaight
# Host interface Postgres binds to on the host machine.
# 127.0.0.1 = localhost only (safe default). Set to 0.0.0.0 only if you
# need the DB reachable from outside the host and have a firewall in front.
POSTGRES_BIND_HOST=127.0.0.1

# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------
SECRET_KEY=your_django_secret_key
# Set to False in production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed frontend origins (leave empty to allow all — dev only)
CORS_ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Security — set all four to True when serving over HTTPS
USE_X_FORWARDED_HOST=False
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# Clickjacking protection. DENY | SAMEORIGIN
X_FRAME_OPTIONS=DENY
# HTTP Strict Transport Security. Leave 0 to disable.
# Recommended prod value once HTTPS is confirmed: 31536000 (1 year).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Swagger. When DEBUG=False, /swagger/ requires an authenticated admin by default
# to avoid leaking the full API schema. Set False to expose public API docs.
SWAGGER_REQUIRE_AUTH=True

# DRF throttling. Disable if you rate-limit at the proxy/CDN layer.
ENABLE_DRF_THROTTLE=True
THROTTLE_ANON=30/minute
THROTTLE_USER=120/minute
THROTTLE_LOGIN=5/minute
THROTTLE_PASSWORD_RESET=3/minute

# JWT (optional — defaults to HS256 / SECRET_KEY)
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------
# AWS (used by boto3 — e.g. S3 uploads)
# -----------------------------------------------------------------------
AWS_ACCESS_KEY=your_aws_access_key
AWS_ACCESS_SECRET=your_aws_secret_key
AWS_REGION=eu-central-1

# -----------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------
N8N_API_KEY=your_n8n_api_key_here
N8N_BASE_URL=http://localhost:5678/api/v1
N8N_KB_KEY=your_n8n_kb_key_here
N8N_TIMEOUT=15
N8N_SSL_HOST=your-app-domain.com
N8N_UI_BASE_URL=http://localhost:5678
N8N_UI_WORKFLOW_PATH_TEMPLATE=/workflow/{id}
N8N_DB_PASSWORD=n8n_password_here

N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678
GENERIC_TIMEZONE=UTC

# Host interface n8n binds to on the host machine.
# 127.0.0.1 = localhost only (safe default). Set to 0.0.0.0 only if you
# have a reverse proxy (Traefik/nginx) or firewall in front of n8n.
N8N_BIND_HOST=127.0.0.1
# Sandbox Execute Code nodes from the container env.
# Leave "true" unless a workflow genuinely needs process.env access —
# when "false", any workflow author can read every secret in the n8n container.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# -----------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_N8N_CHAT_URL=http://localhost:5678/webhook/<code>/chat
VITE_N8N_SUPPORT_ASSISTANT_URL=http://localhost:5678/webhook/<code>/chat

# Legacy — used by docker-compose to pass the frontend base URL to Django
REACT_URL=http://localhost:8080/

# -----------------------------------------------------------------------
# YouScan connector
# -----------------------------------------------------------------------
# Comma-separated list of YouScan API keys (one per account/workspace)
YOUSCAN_API_KEYS=your_key_1,your_key_2,your_key_3
# Base URL for the YouScan external API
YOUSCAN_URL=https://api.youscan.io/api/external/

# -----------------------------------------------------------------------
# Normalization pipeline
# -----------------------------------------------------------------------
# SQLAlchemy URL for the analytics warehouse DB (separate from the Django app DB)
WAREHOUSE_DATABASE_URL=mysql+pymysql://user:password@host:3306/warehouse_db
# Local directory where the collector writes raw JSON files
RAW_DATA_DIR=./data/raw
# Local directory where the normalizer moves processed files
INGESTED_DATA_DIR=./data/ingested

# -----------------------------------------------------------------------
# GitHub Actions — Docs Update workflow
# -----------------------------------------------------------------------
# OpenRouter API key used by the LLM docs-update action.
# Also set this as a GitHub Actions secret named OPENROUTER_API_KEY
# in your repository settings (Settings → Secrets → Actions).
OPENROUTER_API_KEY=your_openrouter_api_key
